   "source": [
    "# ======================================================================\n",
    "# 5. TIME-HOPPING LAYER: keyed hopping across Kerr-comb lines\n",
    "# ----------------------------------------------------------------------\n",
    "# Each symbol slot n is transmitted on one comb line h[n] selected by a hop\n",
    "# key. Both ends derive the same key, so the receiver de-hops for free. The\n",
    "# comb lines are mutually coherent (shared pump), so the carrier phase random\n",
    "# walk is common to all of them and the cell-2 receiver works unchanged.\n",
    "# Without the hop key an attacker sees only ~1/N_COMB of the payload on any\n",
    "# single line, and those samples are still amplitude/phase scrambled.\n",
    "#\n",
    "# Lines are assumed balanced (equal ASE floor); a real soliton comb follows a\n",
    "# sech^2 envelope, which only makes off-centre hops noisier.\n",
    "#\n",
    "# Requires the QAM-16 subsystem cell above (HybridKeyEngine,\n",
    "# generate_qam16_symbols, apply_pre_distortion, receiver_dsp_pipeline).\n",
    "# ======================================================================\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "ROOT = b\"authenticated_puf_qrng_root_001\"\n",
    "N_COMB = 64                # available Kerr-comb lines (hop channels)\n",
    "total_symbols = 4096\n",
    "block_size = 1024\n",
    "SNR_DB = 25.0\n",
    "\n",
    "# Keys: same derivation on both sides\n",
    "engine = HybridKeyEngine(ROOT)\n",
    "pd_key = engine.derive_key(\"PD-KEY\")     # data-scrambling key\n",
    "hop_key = engine.derive_key(\"HOP-KEY\")   # time-hopping key\n",
    "\n",
    "# TX: payload and keyed scrambling\n",
    "tx_payload = generate_qam16_symbols(total_symbols)\n",
    "tx_scrambled = apply_pre_distortion(tx_payload, pd_key, block_size=block_size)\n",
    "\n",
    "# Payload index carried at each time index, mirroring apply_pre_distortion's\n",
    "# RNG consumption so the mapping stays aligned.\n",
    "seed_int = int.from_bytes(pd_key[:4], 'big')\n",
    "rng = np.random.default_rng(seed_int)\n",
    "pi_map = np.empty(total_symbols, dtype=np.int64)\n",
    "for b in range(total_symbols // block_size):\n",
    "    i0, i1 = b * block_size, (b + 1) * block_size\n",
    "    pi_map[i0:i1] = rng.permutation(block_size)\n",
    "    rng.uniform(0.6, 1.4, size=block_size)\n",
    "    rng.uniform(0, 2 * np.pi, size=block_size)\n",
    "payload_idx_of_time = (np.arange(total_symbols) // block_size) * block_size + pi_map\n",
    "\n",
    "# Hop pattern: comb line used at each symbol time\n",
    "hop_rng = np.random.default_rng(int.from_bytes(hop_key[:4], 'big'))\n",
    "hop_lines = hop_rng.integers(0, N_COMB, size=total_symbols)\n",
    "\n",
    "def run_hop_link(seed, snr_db):\n",
    "    \"\"\"Run the hop link once; return the receiver recovery and the single-line tap.\"\"\"\n",
    "    np.random.seed(seed)\n",
    "\n",
    "    # Common laser phase noise, shared by all comb lines\n",
    "    sigma_phase = np.sqrt(2 * np.pi * (50.0e3) / (32.0e9))\n",
    "    common_phase = np.exp(1j * np.cumsum(np.random.normal(0, sigma_phase, total_symbols)))\n",
    "\n",
    "    # Per-line ASE noise, present at every slot on every line\n",
    "    sig_power = np.mean(np.abs(tx_scrambled) ** 2)\n",
    "    nsig = np.sqrt(sig_power / (2 * 10 ** (snr_db / 10.0)))\n",
    "    noise_mat = (np.random.normal(0, nsig, (N_COMB, total_symbols))\n",
    "                 + 1j * np.random.normal(0, nsig, (N_COMB, total_symbols)))\n",
    "\n",
    "    # Receiver: take the noise of the line that was actually used\n",
    "    rx_hop = tx_scrambled * common_phase + noise_mat[hop_lines, np.arange(total_symbols)]\n",
    "\n",
    "    # Authorized de-hop and standard receiver\n",
    "    qam = np.array([-3, -1, 1, 3]) / np.sqrt(10.0)\n",
    "    ideal = (qam[:, None] + 1j * qam[None, :]).flatten()\n",
    "    bob_rec = receiver_dsp_pipeline(rx_hop, pd_key, block_size=block_size)\n",
    "    re_ = qam[np.argmin(np.abs(bob_rec.real[:, None] - qam[None, :]), axis=1)]\n",
    "    im_ = qam[np.argmin(np.abs(bob_rec.imag[:, None] - qam[None, :]), axis=1)]\n",
    "    bob_sliced = re_ + 1j * im_\n",
    "    bob_errs = np.sum(np.abs(bob_sliced - tx_payload) > 1e-4)\n",
    "\n",
    "    # Eavesdropper: tap the most-used line and detect occupied slots by energy\n",
    "    counts = np.bincount(hop_lines, minlength=N_COMB)\n",
    "    c = int(np.argmax(counts))\n",
    "    line_trace = noise_mat[c].copy()\n",
    "    data_times = np.where(hop_lines == c)[0]\n",
    "    line_trace[data_times] = (tx_scrambled[data_times] * common_phase[data_times]\n",
    "                              + noise_mat[c, data_times])\n",
    "    thr = 5.0 * nsig\n",
    "    detected = np.where(np.abs(line_trace) > thr)[0]\n",
    "    d2 = np.abs(line_trace[detected][:, None] - ideal[None, :]) ** 2\n",
    "    eve_sliced = ideal[np.argmin(d2, axis=1)]\n",
    "    true_at_det = tx_payload[payload_idx_of_time[detected]]\n",
    "    eve_errs = np.sum(np.abs(eve_sliced - true_at_det) > 1e-4)\n",
    "    false_alarm = np.sum(detected[~np.isin(detected, data_times)] > -1)\n",
    "    true_hits = np.sum(np.isin(detected, data_times))\n",
    "\n",
    "    return dict(bob_errs=bob_errs, bob_rec=bob_rec,\n",
    "                eve_line=c, eve_errs=eve_errs, eve_detected=len(detected),\n",
    "                eve_true_hits=true_hits, eve_false=false_alarm,\n",
    "                rx_hop=rx_hop, line_trace=line_trace, data_times=data_times)\n",
    "\n",
    "# End-to-end demo over several seeds\n",
    "print(f\"Comb lines available : {N_COMB}\")\n",
    "print(f\"Symbol slots         : {total_symbols}\")\n",
    "res = []\n",
    "for seed in range(5):\n",
    "    r = run_hop_link(seed, SNR_DB)\n",
    "    res.append(r)\n",
    "    print(f\"seed {seed}: Bob SER = {r['bob_errs']}/{total_symbols}   |  Eve(line {r['eve_line']}): \"\n",
    "          f\"detected {r['eve_detected']} slots (true data {r['eve_true_hits']}), \"\n",
    "          f\"decoded {r['eve_errs']}/{r['eve_detected']} wrong\")\n",
    "r0 = res[0]\n",
    "print(f\"TOTAL 5 seeds: Bob errors = {sum(r['bob_errs'] for r in res)}/{5*total_symbols} \"\n",
    "      f\"-> SER = {sum(r['bob_errs'] for r in res)/(5*total_symbols):.2e}\")\n",
    "cap_fraction = np.mean([r['eve_true_hits'] for r in res]) / total_symbols\n",
    "print(f\"Eve sees only ~{cap_fraction*100:.1f}% of the payload on one tapped line \"\n",
    "      f\"(~1/{N_COMB}), and decodes essentially all of it wrong (no keys).\")\n",
    "\n",
    "# ======================================================================\n",
    "# PLOTS (seed-0 run)\n",
    "# ======================================================================\n",
    "nfirst = 400\n",
    "fig, axs = plt.subplots(1, 4, figsize=(20, 4.8))\n",
    "fig.suptitle(\"Time-Hopping across Kerr-Comb Lines: keyed channel selection (seed 0)\",\n",
    "             fontsize=13, fontweight='bold')\n",
    "\n",
    "# 1) Hop pattern\n",
    "axs[0].scatter(np.arange(nfirst), hop_lines[:nfirst], s=5, c='tab:blue', alpha=0.6)\n",
    "axs[0].set_title(\"1) Hop pattern  line h[n] vs symbol index\")\n",
    "axs[0].set_xlabel(\"Symbol index\")\n",
    "axs[0].set_ylabel(\"Comb line (mode)\")\n",
    "axs[0].set_ylim(-1, N_COMB)\n",
    "axs[0].grid(True, alpha=0.3)\n",
    "\n",
    "# 2) Occupancy per line\n",
    "occ = np.bincount(hop_lines, minlength=N_COMB)\n",
    "axs[1].bar(np.arange(N_COMB), occ, color='tab:blue', alpha=0.75)\n",
    "axs[1].axhline(total_symbols / N_COMB, color='crimson', ls='--', lw=1,\n",
    "               label=f\"ideal {total_symbols/N_COMB:.0f}/line\")\n",
    "axs[1].set_title(\"2) Comb-line occupancy (uniform -> no line is 'special')\")\n",
    "axs[1].set_xlabel(\"Comb line\")\n",
    "axs[1].set_ylabel(\"# symbols\")\n",
    "axs[1].legend(fontsize=8)\n",
    "axs[1].grid(True, alpha=0.3)\n",
    "\n",
    "# 3) Receiver constellation after de-hopping\n",
    "qam = np.array([-3, -1, 1, 3]) / np.sqrt(10.0)\n",
    "ideal_grid = (qam[:, None] + 1j * qam[None, :]).flatten()\n",
    "axs[2].plot(ideal_grid.real, ideal_grid.imag, 'k+', ms=9, mew=1.2, alpha=0.45, zorder=1)\n",
    "axs[2].scatter(r0['bob_rec'].real, r0['bob_rec'].imag, s=5, c='tab:green', alpha=0.45)\n",
    "axs[2].set_title(f\"3) Bob (has HOP-KEY + PD-KEY): QAM-16 restored\\n\"\n",
    "                 f\"SER = {r0['bob_errs']}/{total_symbols}\")\n",
    "axs[2].set_xlabel(\"In-phase\"); axs[2].set_ylabel(\"Quadrature\")\n",
    "axs[2].set_xlim(-1.7, 1.7); axs[2].set_ylim(-1.7, 1.7)\n",
    "axs[2].set_aspect('equal', adjustable='box')\n",
    "axs[2].grid(True, alpha=0.25)\n",
    "\n",
    "# 4) Eavesdropper view on the tapped line\n",
    "axs[3].plot(r0['line_trace'].real, r0['line_trace'].imag, '.', ms=2, alpha=0.5,\n",
    "            color='grey', label=\"ASE-only slots\")\n",
    "mask = np.zeros_like(r0['line_trace'], dtype=bool)\n",
    "mask[r0['data_times']] = True\n",
    "axs[3].plot(r0['line_trace'][mask].real, r0['line_trace'][mask].imag, 'o', ms=5,\n",
    "            alpha=0.6, color='tab:red', label=\"data slots on this line\")\n",
    "axs[3].set_title(f\"4) Eve taps line {r0['eve_line']} only: ~1/{N_COMB} of payload,\\n\"\n",
    "                 f\"still amplitude/phase-scrambled (no keys)\")\n",
    "axs[3].set_xlabel(\"In-phase\"); axs[3].set_ylabel(\"Quadrature\")\n",
    "axs[3].set_xlim(-2.2, 2.2); axs[3].set_ylim(-2.2, 2.2)\n",
    "axs[3].set_aspect('equal', adjustable='box')\n",
    "axs[3].legend(fontsize=8, loc='upper right')\n",
    "axs[3].grid(True, alpha=0.25)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
