   "source": [
    "\"\"\"\n",
    "Physical-layer security link for a Kerr-comb QAM-16 transmission.\n",
    "\n",
    "The cell implements the four subsystems of the link:\n",
    "\n",
    "1. HybridKeyEngine  - expands a shared root secret into independent,\n",
    "                      purpose-bound sub-keys.\n",
    "2. Transmitter DSP  - QAM-16 payload generation and keyed pre-distortion.\n",
    "3. Optical channel  - carrier frequency offset, laser phase noise, ASE noise.\n",
    "4. Receiver DSP     - frequency-offset compensation, inverse pre-distortion,\n",
    "                      carrier phase recovery and symbol slicing.\n",
    "\n",
    "Both link ends are assumed to share the same root secret (for example from QKD\n",
    "or a PUF); every other key is derived from it.\n",
    "\"\"\"\n",
    "\n",
    "import hashlib\n",
    "import hmac\n",
    "import numpy as np\n",
    "\n",
    "# ----------------------------------------------------------------------\n",
    "# 1. SUBSYSTEM 3: HYBRID KEY ENGINE\n",
    "# ----------------------------------------------------------------------\n",
    "class HybridKeyEngine:\n",
    "    \"\"\"Derive independent sub-keys from a shared root secret.\"\"\"\n",
    "\n",
    "    def __init__(self, shared_root_secret: bytes):\n",
    "        \"\"\"Store the root secret.\n",
    "\n",
    "        Parameters\n",
    "        ----------\n",
    "        shared_root_secret : bytes\n",
    "            Root key material shared by transmitter and receiver.\n",
    "        \"\"\"\n",
    "        self.master_secret = shared_root_secret\n",
    "\n",
    "    def derive_key(self, context_label: str) -> bytes:\n",
    "        \"\"\"Derive a 256-bit sub-key bound to a context label.\n",
    "\n",
    "        The label acts as key-separation information: different labels yield\n",
    "        independent sub-keys from the same root secret.\n",
    "\n",
    "        Parameters\n",
    "        ----------\n",
    "        context_label : str\n",
    "            Purpose identifier, e.g. ``\"PD-KEY\"`` or ``\"HOP-KEY\"``.\n",
    "\n",
    "        Returns\n",
    "        -------\n",
    "        bytes\n",
    "            A 32-byte sub-key.\n",
    "        \"\"\"\n",
    "        info = context_label.encode('utf-8')\n",
    "        return hmac.new(self.master_secret, info, hashlib.sha256).digest()\n",
    "\n",
    "# ----------------------------------------------------------------------\n",
    "# 2. SUBSYSTEM 2: TRANSMITTER DSP\n",
    "# ----------------------------------------------------------------------\n",
    "def generate_qam16_symbols(num_symbols):\n",
    "    \"\"\"Generate random QAM-16 symbols.\n",
    "\n",
    "    The constellation uses the points {-3, -1, +1, +3} on each axis,\n",
    "    normalised by sqrt(10) so that the average symbol power is one.\n",
    "\n",
    "    Parameters\n",
    "    ----------\n",
    "    num_symbols : int\n",
    "        Number of symbols to generate.\n",
    "\n",
    "    Returns\n",
    "    -------\n",
    "    ndarray, complex\n",
    "        Unit-average-power QAM-16 symbols.\n",
    "    \"\"\"\n",
    "    alphabet = np.array([-3, -1, 1, 3])\n",
    "    real_parts = np.random.choice(alphabet, num_symbols)\n",
    "    imag_parts = np.random.choice(alphabet, num_symbols)\n",
    "    return (real_parts + 1j * imag_parts) / np.sqrt(10.0)\n",
    "\n",
    "def apply_pre_distortion(symbols, pd_key, block_size=1024):\n",
    "    \"\"\"Apply the keyed pre-distortion transform to the payload.\n",
    "\n",
    "    Symbols are processed in blocks of ``block_size``. For each block the\n",
    "    keystream derived from ``pd_key`` drives two operations:\n",
    "\n",
    "    1. temporal interleaving: a permutation of the symbol positions;\n",
    "    2. amplitude and phase scrambling: each symbol is multiplied by\n",
    "       ``A * exp(1j * phi)`` with ``A ~ U(0.6, 1.4)`` and\n",
    "       ``phi ~ U(0, 2*pi)``.\n",
    "\n",
    "    Because the keystream is keyed, only a receiver holding the same\n",
    "    ``pd_key`` can invert the transform; to anyone else the output is an\n",
    "    isotropic, noise-like cloud with no exploitable constellation structure.\n",
    "\n",
    "    Parameters\n",
    "    ----------\n",
    "    symbols : ndarray, complex\n",
    "        Payload symbols.\n",
    "    pd_key : bytes\n",
    "        Pre-distortion key; its first four bytes seed the keystream RNG.\n",
    "    block_size : int\n",
    "        Block length, in symbols, over which the keystream is generated.\n",
    "\n",
    "    Returns\n",
    "    -------\n",
    "    ndarray, complex\n",
    "        Pre-distorted symbols.\n",
    "    \"\"\"\n",
    "    seed_int = int.from_bytes(pd_key[:4], 'big')\n",
    "    rng = np.random.default_rng(seed_int)\n",
    "    \n",
    "    num_blocks = len(symbols) // block_size\n",
    "    scrambled = np.zeros_like(symbols, dtype=np.complex128)\n",
    "    \n",
    "    for b in range(num_blocks):\n",
    "        idx_start = b * block_size\n",
    "        idx_end = idx_start + block_size\n",
    "        block = symbols[idx_start:idx_end]\n",
    "        \n",
    "        # 1. Temporal interleaving\n",
    "        pi = rng.permutation(block_size)\n",
    "        interleaved = block[pi]\n",
    "        \n",
    "        # 2. Dynamic scaling and phase scrambling\n",
    "        A = rng.uniform(0.6, 1.4, size=block_size)\n",
    "        phi = rng.uniform(0, 2 * np.pi, size=block_size)\n",
    "        \n",
    "        scrambled[idx_start:idx_end] = A * np.exp(1j * phi) * interleaved\n",
    "        \n",
    "    return scrambled\n",
    "\n",
    "# ----------------------------------------------------------------------\n",
    "# 3. OPTICAL CHANNEL MODEL\n",
    "# ----------------------------------------------------------------------\n",
    "def optical_channel_simulator(signal, delta_f_ghz=1.2, linewidth_khz=50.0, \n",
    "                               symbol_rate_gbd=32.0, snr_db=25.0):\n",
    "    \"\"\"Propagate the signal through a noisy optical channel.\n",
    "\n",
    "    Three impairments are applied in order:\n",
    "\n",
    "    1. coarse carrier frequency offset ``delta_f_ghz``;\n",
    "    2. Wiener laser phase noise with linewidth ``linewidth_khz``;\n",
    "    3. additive white Gaussian noise (ASE) at the requested SNR.\n",
    "\n",
    "    Parameters\n",
    "    ----------\n",
    "    signal : ndarray, complex\n",
    "        Complex baseband symbols.\n",
    "    delta_f_ghz : float\n",
    "        Carrier frequency offset, in GHz.\n",
    "    linewidth_khz : float\n",
    "        Combined laser linewidth, in kHz.\n",
    "    symbol_rate_gbd : float\n",
    "        Symbol rate, in GBd.\n",
    "    snr_db : float\n",
    "        Signal-to-noise ratio, in dB.\n",
    "\n",
    "    Returns\n",
    "    -------\n",
    "    ndarray, complex\n",
    "        Impaired samples.\n",
    "    \"\"\"\n",
    "    n = len(signal)\n",
    "    t = np.arange(n) / (symbol_rate_gbd * 1e9)\n",
    "    \n",
    "    # Coarse frequency offset\n",
    "    freq_drift = np.exp(1j * 2 * np.pi * (delta_f_ghz * 1e9) * t)\n",
    "    \n",
    "    # Wiener phase noise: random walk with step sigma_phase per symbol\n",
    "    sigma_phase = np.sqrt(2 * np.pi * (linewidth_khz * 1e3) / (symbol_rate_gbd * 1e9))\n",
    "    laser_phase = np.exp(1j * np.cumsum(np.random.normal(0, sigma_phase, n)))\n",
    "    \n",
    "    impaired = signal * freq_drift * laser_phase\n",
    "    \n",
    "    # ASE noise, scaled to the requested SNR\n",
    "    sig_power = np.mean(np.abs(impaired)**2)\n",
    "    snr_linear = 10**(snr_db / 10.0)\n",
    "    noise_sigma = np.sqrt(sig_power / (2 * snr_linear))\n",
    "    noise = np.random.normal(0, noise_sigma, n) + 1j * np.random.normal(0, noise_sigma, n)\n",
    "    \n",
    "    return impaired + noise\n",
    "\n",
    "# ----------------------------------------------------------------------\n",
    "# 4. SUBSYSTEM 4: RECEIVER DSP PIPELINE\n",
    "# ----------------------------------------------------------------------\n",
    "def coarse_frequency_compensation(received, delta_f_ghz=1.2, symbol_rate_gbd=32.0):\n",
    "    \"\"\"Remove a known carrier frequency offset by derotating the samples.\n",
    "\n",
    "    Parameters\n",
    "    ----------\n",
    "    received : ndarray, complex\n",
    "        Received samples.\n",
    "    delta_f_ghz : float\n",
    "        Carrier frequency offset to remove, in GHz.\n",
    "    symbol_rate_gbd : float\n",
    "        Symbol rate, in GBd.\n",
    "\n",
    "    Returns\n",
    "    -------\n",
    "    ndarray, complex\n",
    "        Frequency-compensated samples.\n",
    "    \"\"\"\n",
    "    t = np.arange(len(received)) / (symbol_rate_gbd * 1e9)\n",
    "    return received * np.exp(-1j * 2 * np.pi * (delta_f_ghz * 1e9) * t)\n",
    "\n",
    "def receiver_dsp_pipeline(rx_foe, pd_key, block_size=1024, sub_len=32, return_phases=False):\n",
    "    \"\"\"Undo the keyed pre-distortion and recover the carrier phase.\n",
    "\n",
    "    For each block the receiver mirrors the transmitter:\n",
    "\n",
    "    1. regenerate the keystream from ``pd_key`` and invert the amplitude and\n",
    "       phase scrambling in temporal order, keeping the residual phase smooth;\n",
    "    2. estimate the residual carrier phase on sub-blocks of ``sub_len``\n",
    "       symbols with a blind phase search and derotate;\n",
    "    3. invert the interleaving permutation to restore payload order.\n",
    "\n",
    "    The phase estimate is tracked continuously over the whole frame; the\n",
    "    ``block_size`` boundaries only group the keystream and never reset it.\n",
    "\n",
    "    Notes\n",
    "    -----\n",
    "    QAM-16 is invariant under 90-degree rotations, so a full-range phase\n",
    "    search (0 to 2*pi) has four equally good minima and cannot resolve the\n",
    "    quadrant, while a pilot symbol taken from the constellation shares the\n",
    "    same symmetry. The search window is therefore restricted to a narrow\n",
    "    interval (< pi/2) around the running estimate: this leaves a single\n",
    "    minimum and lets the estimate follow the laser phase random walk without\n",
    "    jumping a quadrant.\n",
    "\n",
    "    Parameters\n",
    "    ----------\n",
    "    rx_foe : ndarray, complex\n",
    "        Samples after frequency-offset compensation.\n",
    "    pd_key : bytes\n",
    "        Pre-distortion key.\n",
    "    block_size : int\n",
    "        Keystream block length; must match the transmitter.\n",
    "    sub_len : int\n",
    "        Symbols per phase-estimation sub-block.\n",
    "    return_phases : bool\n",
    "        If True, also return the tracked phase per sub-block.\n",
    "\n",
    "    Returns\n",
    "    -------\n",
    "    ndarray, complex\n",
    "        Recovered symbols, or ``(symbols, phases)`` if ``return_phases``.\n",
    "    \"\"\"\n",
    "    seed_int = int.from_bytes(pd_key[:4], 'big')\n",
    "    rng = np.random.default_rng(seed_int)\n",
    "    \n",
    "    num_blocks = len(rx_foe) // block_size\n",
    "    recovered_symbols = np.zeros_like(rx_foe, dtype=np.complex128)\n",
    "    \n",
    "    # Reference constellation points\n",
    "    qam = np.array([-3, -1, 1, 3]) / np.sqrt(10.0)\n",
    "    ideal_pts = (qam[:, None] + 1j * qam[None, :]).flatten()\n",
    "    \n",
    "    # Search window around the running phase estimate (dphi < pi/2)\n",
    "    dphi = 0.25\n",
    "    phase_offsets = np.linspace(-dphi, dphi, 300)\n",
    "    \n",
    "    n_sub = num_blocks * (block_size // sub_len)\n",
    "    tracked_phases = np.zeros(n_sub)\n",
    "    sb_idx = 0\n",
    "    \n",
    "    phase_est = 0.0\n",
    "    for b in range(num_blocks):\n",
    "        idx_start = b * block_size\n",
    "        idx_end = idx_start + block_size\n",
    "        chunk = rx_foe[idx_start:idx_end]\n",
    "        \n",
    "        # Regenerate the identical keystream\n",
    "        pi = rng.permutation(block_size)\n",
    "        A = rng.uniform(0.6, 1.4, size=block_size)\n",
    "        phi = rng.uniform(0, 2 * np.pi, size=block_size)\n",
    "        \n",
    "        # 1. Invert the amplitude and phase pre-distortion\n",
    "        descrambled = (1.0 / A) * np.exp(-1j * phi) * chunk\n",
    "        \n",
    "        # 2. Sliding-window blind phase search\n",
    "        cpr_chunk = np.zeros_like(descrambled)\n",
    "        for s in range(0, block_size, sub_len):\n",
    "            sub = descrambled[s:s + sub_len]\n",
    "            candidates = phase_est + phase_offsets\n",
    "            errors = []\n",
    "            for cand in candidates:\n",
    "                rotated = sub * np.exp(-1j * cand)\n",
    "                dist = np.min(np.abs(rotated[:, None] - ideal_pts[None, :])**2, axis=1)\n",
    "                errors.append(np.sum(dist))\n",
    "            best_phase = candidates[np.argmin(errors)]\n",
    "            cpr_chunk[s:s + sub_len] = sub * np.exp(-1j * best_phase)\n",
    "            phase_est = best_phase\n",
    "            tracked_phases[sb_idx] = best_phase\n",
    "            sb_idx += 1\n",
    "        \n",
    "        # 3. Invert the interleaving permutation\n",
    "        inv_pi = np.empty_like(pi)\n",
    "        inv_pi[pi] = np.arange(block_size)\n",
    "        recovered_symbols[idx_start:idx_end] = cpr_chunk[inv_pi]\n",
    "        \n",
    "    if return_phases:\n",
    "        return recovered_symbols, tracked_phases\n",
    "    return recovered_symbols\n",
    "\n",
    "# ----------------------------------------------------------------------\n",
    "# EXECUTION PIPELINE\n",
    "# ----------------------------------------------------------------------\n",
    "if __name__ == \"__main__\":\n",
    "    np.random.seed(42)\n",
    "    \n",
    "    # Key derivation: one root secret, one sub-key per purpose\n",
    "    shared_key_root = b\"authenticated_puf_qrng_root_001\" \n",
    "    engine = HybridKeyEngine(shared_key_root)\n",
    "    pd_key = engine.derive_key(\"PD-KEY\") \n",
    "    \n",
    "    # Transmitter\n",
    "    total_symbols = 4096\n",
    "    block_size = 1024\n",
    "    tx_payload = generate_qam16_symbols(total_symbols)\n",
    "    tx_scrambled = apply_pre_distortion(tx_payload, pd_key, block_size=block_size) \n",
    "    \n",
    "    # Channel\n",
    "    rx_optical = optical_channel_simulator(\n",
    "        tx_scrambled, delta_f_ghz=1.2, linewidth_khz=50.0, symbol_rate_gbd=32.0, snr_db=25.0\n",
    "    ) \n",
    "    \n",
    "    # Receiver\n",
    "    rx_foe = coarse_frequency_compensation(rx_optical, delta_f_ghz=1.2, symbol_rate_gbd=32.0) \n",
    "    rx_recovered = receiver_dsp_pipeline(rx_foe, pd_key, block_size=block_size) \n",
    "    \n",
    "    # Slicing and validation\n",
    "    qam = np.array([-3, -1, 1, 3]) / np.sqrt(10.0)\n",
    "    real_dec = qam[np.argmin(np.abs(rx_recovered.real[:, None] - qam[None, :]), axis=1)]\n",
    "    imag_dec = qam[np.argmin(np.abs(rx_recovered.imag[:, None] - qam[None, :]), axis=1)]\n",
    "    sliced_symbols = real_dec + 1j * imag_dec\n",
    "    \n",
    "    symbol_errors = np.sum(np.abs(sliced_symbols - tx_payload) > 1e-4)\n",
    "    ser = symbol_errors / total_symbols\n",
    "    \n",
    "    print(f\"Total Transmitted Symbols : {total_symbols}\")\n",
    "    print(f\"Symbol Error Rate (SER)     : {ser:.4e}\")\n",
    "    print(f\"Channel Recovery Status     : {'Success (Decodable by SD-FEC)' if ser < 0.05 else 'Failed'}\")"
   ]
  },
