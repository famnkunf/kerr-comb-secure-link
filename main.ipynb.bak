    "# ----------------------------------------------------------------------\n",
    "# VISUALIZATION: QAM-16 constellation through the link\n",
    "# Requires the pipeline cell above to have been executed.\n",
    "# ----------------------------------------------------------------------\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "qam = np.array([-3, -1, 1, 3]) / np.sqrt(10.0)\n",
    "ideal_grid = (qam[:, None] + 1j * qam[None, :]).flatten()\n",
    "\n",
    "# Rerun the receiver to get the recovered symbols for plotting\n",
    "rx_rec = receiver_dsp_pipeline(rx_foe, pd_key, block_size=block_size)\n",
    "\n",
    "real_dec = qam[np.argmin(np.abs(rx_rec.real[:, None] - qam[None, :]), axis=1)]\n",
    "imag_dec = qam[np.argmin(np.abs(rx_rec.imag[:, None] - qam[None, :]), axis=1)]\n",
    "sliced = real_dec + 1j * imag_dec\n",
    "err_mask = np.abs(sliced - tx_payload) > 1e-4\n",
    "\n",
    "def style_constellation(ax, title, show_grid=True, lim=1.7):\n",
    "    if show_grid:\n",
    "        ax.plot(ideal_grid.real, ideal_grid.imag, 'k+', ms=9, mew=1.2, alpha=0.45, zorder=1)\n",
    "    ax.set_title(title, fontsize=11)\n",
    "    ax.set_xlabel(\"In-phase (I)\")\n",
    "    ax.set_ylabel(\"Quadrature (Q)\")\n",
    "    ax.set_xlim(-lim, lim)\n",
    "    ax.set_ylim(-lim, lim)\n",
    "    ax.set_aspect('equal', adjustable='box')\n",
    "    ax.grid(True, alpha=0.25)\n",
    "\n",
    "fig, axs = plt.subplots(2, 2, figsize=(16.5, 9.5))\n",
    "fig.suptitle(\"QAM-16 Physical-Layer Security Link: constellation stages and receiver DSP\",\n",
    "             fontsize=14, fontweight='bold')\n",
    "\n",
    "# 1) Transmitter payload\n",
    "axs[0, 0].scatter(tx_payload.real, tx_payload.imag, s=6, c='tab:blue', alpha=0.5)\n",
    "style_constellation(axs[0, 0], \"1) TX payload (Alice): standard QAM-16\")\n",
    "\n",
    "# 2) After keyed pre-distortion\n",
    "axs[0, 1].scatter(tx_scrambled.real, tx_scrambled.imag, s=6, c='tab:orange', alpha=0.5)\n",
    "style_constellation(axs[0, 1], \"2) After keyed pre-distortion: noise-like cloud\",\n",
    "                    show_grid=False, lim=2.2)\n",
    "\n",
    "# 3) After channel and frequency-offset compensation\n",
    "axs[1, 0].scatter(rx_foe.real, rx_foe.imag, s=6, c='tab:red', alpha=0.5)\n",
    "style_constellation(axs[1, 0], \"3) After channel + FOE: still hidden, plus ASE noise\",\n",
    "                    show_grid=False, lim=2.2)\n",
    "\n",
    "# 4) Recovered at the receiver\n",
    "ok = ~err_mask\n",
    "axs[1, 1].scatter(rx_rec[ok].real, rx_rec[ok].imag, s=6, c='tab:green', alpha=0.45, label=\"correct\")\n",
    "if err_mask.any():\n",
    "    axs[1, 1].scatter(rx_rec[err_mask].real, rx_rec[err_mask].imag, s=22, c='red',\n",
    "                      marker='x', label=\"error\")\n",
    "style_constellation(axs[1, 1], \"4) Recovered (Bob): QAM-16 restored\\n\"\n",
    "                               f\"SER = {err_mask.sum()}/{len(tx_payload)} = {err_mask.mean():.2e}\")\n",
    "axs[1, 1].legend(loc='upper right', fontsize=8)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
